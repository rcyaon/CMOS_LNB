v {xschem version=3.4.8RC file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
template="name=x1"
}
T {@symname} 0 -10 0 0 0.3 0.3 {hcenter=true}
T {@name} 95 -42 0 0 0.2 0.2 {}
P 4 5 90 -20 -90 -20 -90 20 90 20 90 -20 {}
B 5 -112.5 -2.5 -107.5 2.5 {name=vdd dir=inout}
L 7 -110 0 -90 0 {}
T {vdd} -85 -4 0 0 0.2 0.2 {}
B 5 107.5 -2.5 112.5 2.5 {name=lo dir=inout}
L 7 90 0 110 0 {}
T {lo} 85 -4 0 1 0.2 0.2 {}
